# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
frontend/dist/

# Environment / secrets
.env
!.env.example

# Runtime data (never commit scans, encrypted files, or DBs)
backend/uploads/
backend/logs/
# Safety net: backend/.env uses relative paths, so if the backend is ever
# started from the repo root (not backend/), uploads/ and logs/ land here.
/uploads/
/logs/
*.db
*.sqlite3

# Trained CNN checkpoint — committed intentionally. The API requires it
# (fails loudly without the model), so it ships with the repo.
# (Removed the old `backend/models/*.pth` rule so the model + summaries
# are tracked. Future retrained checkpoints will also be tracked.)

# Training data (large datasets — never commit)
backend/data/

# Runtime logs
*.log
backend_err.log
backend_out.log

# Tooling
.pytest_cache/
.vite/
.eslintcache

# Agent/editor tooling (keep out of the repo)
.agents/
.claude/
skills-lock.json

# OS
.DS_Store
Thumbs.db
