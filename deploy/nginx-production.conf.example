# ============================================================================
# MediScan AI — production nginx (TLS termination)
#
# Copy to the host reverse proxy / container and replace:
#   DOMAIN_NAME          -> your domain (e.g. mediscan.example.com)
#   /etc/nginx/certs/fullchain.pem  -> your real TLS certificate chain
#   /etc/nginx/certs/privkey.pem    -> your real private key
#
# NEVER commit real certificates or keys to the repository.
#
# Network layout:
#   Internet -> HTTPS (this nginx) -> frontend SPA :80 (compose) -> backend :8000
# The backend and PostgreSQL stay internal to the compose network.
# ============================================================================

# --- HTTP -> HTTPS redirect -------------------------------------------------
server {
    listen 80;
    server_name DOMAIN_NAME;

    # HSTS is only safe once HTTPS is confirmed working; uncomment after the
    # first successful TLS rollout:
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS site --------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name DOMAIN_NAME;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;   # placeholder
    ssl_certificate_key /etc/nginx/certs/privkey.pem;     # placeholder
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    server_tokens off;

    # Security headers (HSTS uncomment after TLS is verified live)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'" always;

    root /usr/share/nginx/html;
    index index.html;

    # SPA
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API -> backend container (compose service name)
    location /api/ {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        client_max_body_size 55m;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Hashed static assets
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
