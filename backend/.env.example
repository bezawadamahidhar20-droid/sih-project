# ============================================================================
# MediScan AI — Backend configuration
# Copy to `.env` and adjust values. Never commit real secrets.
# ============================================================================

# --- Application ---
APP_NAME=MediScan AI
DEBUG=false
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
# KEEP AT 1: the login lockout, endpoint rate limiters and the legacy
# refresh-token backstop are in-process stores. Running multiple workers
# would give each process its own state and bypass those limits.
WORKERS=1

# --- Security (generate strong random values in production) ---
JWT_SECRET_KEY=change-me-32-chars-minimum-!!!!!!!!
ENCRYPTION_KEY=change-me-32-chars-minimum-!!!!!!!!
ENCRYPTION_SALT=change-me-16-chars!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
# Production: postgresql+asyncpg://user:pass@host:5432/mediscan
# Local dev:  sqlite+aiosqlite:///./mediscan.db
DATABASE_URL=sqlite+aiosqlite:///./mediscan.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Model inference ---
# Path to a trained state dict for MODEL_ARCHITECTURE. When the file is
# absent the built-in baseline heuristic engine is used automatically, so the
# upload -> predict -> heatmap loop works without a trained model.
MODEL_PATH=./models/model.pth
MODEL_ARCHITECTURE=resnet50
MODEL_NUM_CLASSES=2
MODEL_INPUT_SIZE=224
MODEL_CLASSES=["Normal","Pneumonia"]
# Calibrated decision boundary for the abnormal class in binary (2-class)
# prediction. argmax@0.5 over-flags real-world normals when training data is
# class-imbalanced; 0.8 keeps sensitivity high while cutting false positives.
MODEL_DECISION_THRESHOLD=0.8
# Dev-only: when no trained model is present, serve the deterministic
# baseline heuristic so the upload -> predict -> heatmap loop works out of
# the box locally. Keep false (the default) in production so a missing model
# fails loudly (HTTP 500) instead of serving non-clinical guesses.
ALLOW_HEURISTIC_FALLBACK=true

# --- Auth cookies (HttpOnly / Secure / SameSite) ---
# COOKIE_SECURE auto-derives: true in production, false in development so
# plain-http local development works. Override only in test environments.
# COOKIE_SECURE=

# --- Shared security state (rate limiting / login lockout) ---
# In-process by default. USE_REDIS=true + a reachable REDIS_URL are required
# before raising WORKERS above 1 (the app refuses otherwise).
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# --- Uploads / storage ---
# Local dev: relative to the backend working directory (uvicorn run from
# backend/). Docker compose overrides with /app/uploads + a named volume.
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# --- TLS (optional; terminate TLS at a reverse proxy in production) ---
SSL_CERTFILE=
SSL_KEYFILE=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
# Relative for local dev (backend/logs/); Docker compose overrides to
# /app/logs/audit.log. Never contains PHI.
AUDIT_LOG_PATH=./logs/audit.log

# --- CORS ---
# Vite dev server (5173) proxies /api so CORS is usually irrelevant in dev;
# allowed origins matter only when the frontend calls the API directly
# (VITE_API_URL override).
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# --- Clinical thresholds ---
LOW_CONFIDENCE_THRESHOLD=0.7
HIGH_RISK_THRESHOLD=0.9

# --- Per-user rate limits (429 beyond) ---
UPLOAD_RATE_LIMIT_PER_MINUTE=30
PREDICT_RATE_LIMIT_PER_MINUTE=30

# --- Cloud GPU inference (optional later swap-in; frontend unchanged) ---
USE_EXTERNAL_INFERENCE=false
EXTERNAL_INFERENCE_URL=
EXTERNAL_INFERENCE_API_KEY=

# --- Demo accounts (development only — keep false in production) ---
SEED_DEMO_USERS=true
# Dev-only scan seeding (python seed_demo_scans.py) — synthetic non-PHI
# images + fabricated pre-computed predictions, clearly marked DEMO.
SEED_DEMO_SCANS=true

# --- Refresh-token sessions ---
# API-minted refresh tokens are tracked in the ``refresh_sessions`` table
# (created automatically at startup): rotation is one-time-use, replaying a
# used token revokes the whole session family, and POST /auth/logout burns
# the presented refresh token. No extra configuration required.
