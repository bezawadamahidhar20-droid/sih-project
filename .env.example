[TEMPLATE]
# ============================================================================
# MediScan AI — docker-compose configuration
# Copy this file to `.env` in the project root and adjust values.
# NEVER commit the real `.env`. Generate strong random secrets in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================================

# --- Postgres ---
# REQUIRED (compose fails fast when unset). Never use the old template
# default "mediscan" in production: the backend refuses to boot against
# known-default passwords when ENVIRONMENT=production.
POSTGRES_USER=mediscan
POSTGRES_PASSWORD=change-me-to-a-strong-postgres-password
POSTGRES_DB=mediscan

# --- Security (min lengths enforced by the backend: 32 / 32 / 16) ---
# REQUIRED. `docker compose up` refuses to start when these are missing or
# set to placeholders in a production environment.
JWT_SECRET_KEY=change-me-32-chars-minimum-!!!!!!!!
ENCRYPTION_KEY=change-me-32-chars-minimum-!!!!!!!!
ENCRYPTION_SALT=change-me-16-chars!

# --- Token lifetimes ---
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Security state (rate limiting / login lockout) ---
# In-process by default (single worker). Set USE_REDIS=true and point
# REDIS_URL at a reachable Redis BEFORE scaling WORKERS above 1 — the
# backend refuses to start with WORKERS>1 and USE_REDIS=false.
#
# REDIS_PASSWORD is REQUIRED by compose: the redis container runs with
# requirepass and the backend connects with the same password embedded in
# REDIS_URL. Use an alphanumeric password (no URL-special characters).
USE_REDIS=false
REDIS_PASSWORD=change-me-to-a-strong-alphanumeric-redis-password
REDIS_URL=redis://:change-me-to-a-strong-alphanumeric-redis-password@redis:6379/0

# --- Auth cookies ---
# HttpOnly/Secure/SameSite cookies carry the session. COOKIE_SECURE is
# auto-derived (true in production, false in dev); override only for test
# environments.
# COOKIE_SECURE=

# --- Inference / model ---
# The trained CNN (backend/models/model.pth) is bind-mounted read-only into
# the container. With the model missing AND ALLOW_HEURISTIC_FALLBACK=false
# (the production default), prediction requests fail loudly instead of
# serving guessed diagnoses.
MODEL_ARCHITECTURE=resnet50
MODEL_NUM_CLASSES=2
MODEL_INPUT_SIZE=224
MODEL_CLASSES=["Normal","Pneumonia"]
ALLOW_HEURISTIC_FALLBACK=false

# --- Uploads ---
MAX_FILE_SIZE_MB=50

# --- Clinical thresholds ---
LOW_CONFIDENCE_THRESHOLD=0.7
HIGH_RISK_THRESHOLD=0.9

# --- CORS / CSRF frontend origin ---
# REQUIRED: the CORS allowlist doubles as the CSRF Origin allowlist and the
# backend refuses to boot with non-HTTPS or localhost origins while
# ENVIRONMENT=production. Set the real HTTPS origin of your frontend, e.g.:
#   CORS_ORIGINS=["https://mediscan.example.com"]
CORS_ORIGINS=["https://mediscan.example.com"]

# --- Host ports ---
# Only the frontend (nginx, which proxies /api to the backend) is exposed to
# the host. The backend API and PostgreSQL are internal to the compose
# network; the raw API port is intentionally NOT mapped.
FRONTEND_PORT=8080

# --- Demo accounts (doctor / radiologist / staff, password DemoPass123!) ---
# ⚠️  OFF BY DEFAULT. For the SIH demo, explicitly run:
#       SEED_DEMO_USERS=true docker compose up
# The credentials are well-known and printed in the README — never enable
# seeding on a public deployment.
SEED_DEMO_USERS=false
# Demo scan seeding (dev-only script seed_demo_scans.py) — opt-in, OFF here.
SEED_DEMO_SCANS=false

# --- Environment ---
# production refuses placeholder secrets at startup (JWT/encryption keys,
# known-default PostgreSQL passwords, non-HTTPS CORS origins); development
# does not.
ENVIRONMENT=production
